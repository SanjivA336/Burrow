# Read ONLY by `npm run dev:phone` (Vite "phone" mode), on top of .env. Safe to commit: no secrets.
# The test app on your phone talks to the backend running on this computer, through the tunnel.
VITE_API_BASE_URL=https://dev-api.burrowapp.site
# Don't send the test app's errors to the real Sentry project.
VITE_SENTRY_DSN=
